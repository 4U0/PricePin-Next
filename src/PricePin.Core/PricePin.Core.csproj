<Project Sdk="Microsoft.NET.Sdk">

  <!-- Market data, feeds and history. No UI code, so it builds and tests on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PricePin.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PricePin.Core.Tests" />
    <InternalsVisibleTo Include="FeedProbe" />
  </ItemGroup>

  <ItemGroup>
    <!-- Known event dates; the app downloads the newest copy from GitHub and falls back to this one. -->
    <EmbeddedResource Include="..\..\data\events.json" LogicalName="PricePin.Core.Events.events.json" />
  </ItemGroup>

</Project>
