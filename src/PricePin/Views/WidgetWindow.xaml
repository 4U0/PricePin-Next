<Window x:Class="PricePin.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PricePin.ViewModels"
        x:Name="Root"
        Title="PricePin"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Topmost="{Binding Topmost}"
        Opacity="{Binding Opacity}"
        ContextMenu="{StaticResource AppMenu}">

    <!-- The outer margin leaves room for the soft shadow around the card. -->
    <Grid x:Name="Card" Margin="{x:Static vm:WidgetMetrics.ShadowMargin}" Width="300">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.5" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="0,8,0,8">
            <StackPanel>
                <!-- Header: logo, name, and controls that fade in on hover. -->
                <DockPanel Margin="14,0,8,4" Height="26">
                    <StackPanel x:Name="HeaderButtons" DockPanel.Dock="Right" Orientation="Horizontal" Opacity="0">
                        <Button Click="PinButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="&#xE718;" />
                                    <Setter Property="ToolTip" Value="Stay on top: off" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Topmost}" Value="True">
                                            <Setter Property="Content" Value="&#xE840;" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="ToolTip" Value="Stay on top: on" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Options"
                                Click="MenuButton_Click" Margin="2,0,0,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Hide to tray"
                                Command="{Binding ToggleVisibilityCommand}" Margin="2,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/PricePin.ico" Width="14" Height="14"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="PricePin" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- Coin rows -->
                <ItemsControl ItemsSource="{Binding Coins}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CoinRowViewModel}">
                            <Border x:Name="Row" Margin="6,0" Padding="8,7" CornerRadius="8" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="28" Height="28" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding AccentBrush}" />
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold"
                                                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Symbol}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding PriceText}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular" />

                                    <Border x:Name="Pill" Grid.Column="3" Margin="10,0,0,0" MinWidth="64"
                                            Padding="6,3" CornerRadius="6" VerticalAlignment="Center"
                                            Background="{StaticResource UpSoftBrush}">
                                        <TextBlock x:Name="ChangeText" Text="{Binding ChangeText}" FontSize="11.5"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{StaticResource UpBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUp}" Value="False">
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource DownSoftBrush}" />
                                    <Setter TargetName="ChangeText" Property="Foreground" Value="{StaticResource DownBrush}" />
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Footer status -->
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="14,6,14,0" Padding="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.15" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
