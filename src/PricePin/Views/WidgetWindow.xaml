<Window x:Class="PricePin.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PricePin.ViewModels"
        xmlns:ctl="clr-namespace:PricePin.Controls"
        x:Name="Root"
        Title="PricePin"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Topmost="{Binding Topmost}"
        Opacity="{Binding Opacity}"
        ContextMenu="{StaticResource WidgetMenu}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Status pill colours per connection state. -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="#26F59E0B" />
            <Setter Property="Tag" Value="#F59E0B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding App.StatusState}" Value="Live">
                    <Setter Property="Background" Value="#2622D399" />
                    <Setter Property="Tag" Value="#22D399" />
                </DataTrigger>
                <DataTrigger Binding="{Binding App.StatusState}" Value="Polling">
                    <Setter Property="Background" Value="#2638BDF8" />
                    <Setter Property="Tag" Value="#38BDF8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding App.StatusState}" Value="Offline">
                    <Setter Property="Background" Value="#26F43F5E" />
                    <Setter Property="Tag" Value="#F43F5E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- The outer margin leaves room for the soft shadow around the card. -->
    <Grid x:Name="Card" Margin="{x:Static vm:WidgetMetrics.ShadowMargin}" Width="{Binding CardWidth}">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Grid.LayoutTransform>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="{DynamicResource ShadowOpacity}" />
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="0,10,0,8">
            <StackPanel>
                <!-- Header: brand, live status, and controls that fade in on hover. -->
                <DockPanel Margin="14,0,8,6" Height="26">
                    <StackPanel x:Name="HeaderButtons" DockPanel.Dock="Right" Orientation="Horizontal" Opacity="0" Margin="4,0,0,0">
                        <Button Click="PinButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="&#xE718;" />
                                    <Setter Property="ToolTip" Value="Stay on top: off" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Topmost}" Value="True">
                                            <Setter Property="Content" Value="&#xE840;" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="ToolTip" Value="Stay on top: on" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{DynamicResource Common.Settings}"
                                Command="{Binding App.OpenSettingsCommand}" Margin="2,0,0,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="{DynamicResource Common.Options}"
                                Click="MenuButton_Click" Margin="2,0,0,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="{DynamicResource Common.HideToTray}"
                                Command="{Binding ToggleVisibilityCommand}" Margin="2,0,0,0" />
                    </StackPanel>

                    <!-- Live status: coloured pill + feed name. Hover for details. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Background="Transparent" ToolTip="{Binding App.StatusDetail}">
                        <TextBlock Text="{Binding App.StatusSource}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <Border x:Name="Pill" Style="{StaticResource StatusPill}" CornerRadius="9" Padding="7,2,8,2">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding Tag, ElementName=Pill}" Opacity="0.35" />
                                    <Ellipse Width="6" Height="6" Fill="{Binding Tag, ElementName=Pill}" />
                                </Grid>
                                <TextBlock Text="{Binding App.StatusLabel}" Margin="5,0,0,0" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding Tag, ElementName=Pill}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/PricePin.ico" Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="PricePin" Margin="7,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <!-- Column headings -->
                <Grid Margin="16,2,16,4" TextElement.FontSize="10" TextElement.Foreground="{DynamicResource TextTertiaryBrush}"
                      Visibility="{Binding ShowColumnHeadings, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Widget.Asset}" />
                    <TextBlock Grid.Column="1" Text="{Binding ChangeHeading}" Width="64" TextAlignment="Center"
                               Visibility="{Binding ShowSparklines, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource Widget.Price}" HorizontalAlignment="Right" />
                </Grid>

                <!-- Coin rows; scrolls if the list is taller than most of the screen. -->
                <ScrollViewer x:Name="RowsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                <ItemsControl ItemsSource="{Binding Coins}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CoinRowViewModel}">
                            <Grid Margin="6,1">
                                <!-- Flash layer under the row; kept separate so it never fights the hover highlight. -->
                                <Border CornerRadius="10" ctl:Flash.Pulse="{Binding FlashPulse}" />
                                <Border x:Name="Row" Padding="10,7" CornerRadius="10" Background="Transparent"
                                        ToolTip="{Binding DetailsText}" ToolTipService.InitialShowDelay="600">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Logo, or a coloured badge with the first letter until one is available. -->
                                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                                            <Grid x:Name="Badge">
                                                <Ellipse Fill="{Binding BadgeBrush}" />
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Symbol}" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Visibility="{Binding DataContext.ShowNames, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock x:Name="Holding" Text="{Binding HoldingText}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                       Typography.NumeralAlignment="Tabular" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                        </StackPanel>

                                        <ctl:Sparkline x:Name="Spark" Grid.Column="2" Width="60" Height="26" Margin="2,0"
                                                       Visibility="{Binding DataContext.ShowSparklines, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                       Values="{Binding Sparkline}" LineColor="{DynamicResource UpColor}" />

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding PriceText}" HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource DisplayFont}" FontSize="14.5" FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       ctl:Flash.Pulse="{Binding FlashPulse}" />
                                            <TextBlock x:Name="Change" Text="{Binding ChangeText}" HorizontalAlignment="Right"
                                                       FontSize="11" FontWeight="SemiBold" Margin="0,1,0,0"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{DynamicResource UpBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUp}" Value="False">
                                    <Setter TargetName="Change" Property="Foreground" Value="{DynamicResource DownBrush}" />
                                    <Setter TargetName="Spark" Property="LineColor" Value="{DynamicResource DownColor}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasHolding}" Value="True" />
                                        <Condition Binding="{Binding DataContext.ShowHoldings, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Holding" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding DataContext.App.Portfolio.PrivacyMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter TargetName="Holding" Property="Effect">
                                        <Setter.Value>
                                            <BlurEffect Radius="2.5" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <!-- Portfolio total -->
                <Border Margin="12,4,12,2" Padding="10,7" CornerRadius="10" Background="{DynamicResource HoverBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowHoldings}" Value="True" />
                                        <Condition Binding="{Binding App.Portfolio.HasHoldings}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock x:Name="PortfolioTotal" Text="{Binding App.Portfolio.TotalValueText}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding App.Portfolio.PrivacyMode}" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <BlurEffect Radius="3" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding App.Portfolio.TotalChangeText}" HorizontalAlignment="Right" FontSize="10.5"
                                       FontWeight="SemiBold" Typography.NumeralAlignment="Tabular">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource UpBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding App.Portfolio.TotalUp}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource DownBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Portfolio.Widget}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </DockPanel>
                </Border>

                <!-- Empty state -->
                <TextBlock Text="{DynamicResource Widget.Empty}" Margin="16,8" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Coins.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.15" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
