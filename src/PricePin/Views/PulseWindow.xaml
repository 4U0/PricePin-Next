<Window x:Class="PricePin.Views.PulseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PricePin.ViewModels"
        Title="{DynamicResource Pulse.Title}"
        Width="500" Height="660" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/PricePin.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A whole list row that can be clicked. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row of choices ($100K, $500K, ...) from a list of ChoiceOption. -->
        <DataTemplate x:Key="ChoiceSegment" DataType="{x:Type vm:ChoiceOption}">
            <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding SelectCommand}"
                         Padding="0" FontSize="11.5" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Horizontal">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <Style x:Key="Total" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Title bar -->
        <DockPanel DockPanel.Dock="Top" Height="44" Margin="16,0,6,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE72C;" ToolTip="{DynamicResource Common.Reconnect}" Command="{Binding ReloadCommand}" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="{DynamicResource Common.Minimize}" Click="Minimize_Click" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" ToolTip="{DynamicResource Common.Close}" Click="Close_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/PricePin.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{DynamicResource Pulse.Title}" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Tabs -->
        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentedPanel}" Margin="18,0,18,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="PulseTab" Content="{DynamicResource Pulse.News}"
                             IsChecked="{Binding Tab, Converter={StaticResource EqualsConverter}, ConverterParameter=News}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="PulseTab" Content="{DynamicResource Pulse.Radar}"
                             IsChecked="{Binding Tab, Converter={StaticResource EqualsConverter}, ConverterParameter=Radar}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="PulseTab" Content="{DynamicResource Pulse.Fees}"
                             IsChecked="{Binding Tab, Converter={StaticResource EqualsConverter}, ConverterParameter=Fees}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="PulseTab" Content="{DynamicResource Pulse.Calendar}"
                             IsChecked="{Binding Tab, Converter={StaticResource EqualsConverter}, ConverterParameter=Calendar}" />
            </StackPanel>
        </Border>

        <Grid Margin="18,0,18,14">
            <!-- ================= News ================= -->
            <DockPanel Visibility="{Binding IsNewsTab, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource News.OnlyMyCoins}" IsChecked="{Binding NewsOnlyMyCoins}" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource News.NotifyHeld}" IsChecked="{Binding NotifyHeldCoinNews}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Small}" Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{DynamicResource News.Sources}" Margin="2,8,0,0" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding NewsStatus}" Margin="2,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NewsStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Headlines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HeadlineViewModel}">
                                    <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" ToolTip="{DynamicResource News.OpenTip}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding CoinsText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /><Run Text="{Binding CoinsSeparator, Mode=OneWay}" /><Run Text="{Binding SourceLine, Mode=OneWay}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- ================= Whales & liquidations ================= -->
            <DockPanel Visibility="{Binding IsRadarTab, Converter={StaticResource BoolToVisibility}}">
                <!-- Last-hour totals -->
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Tile}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{DynamicResource Radar.LongsHour}" />
                            <TextBlock Style="{StaticResource Total}" Text="{Binding LongsLiquidatedText}" Foreground="{DynamicResource DownBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Tile}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{DynamicResource Radar.ShortsHour}" />
                            <TextBlock Style="{StaticResource Total}" Text="{Binding ShortsLiquidatedText}" Foreground="{DynamicResource UpBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Tile}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{DynamicResource Radar.BuysHour}" />
                            <TextBlock Style="{StaticResource Total}" Text="{Binding WhaleBuysText}" Foreground="{DynamicResource UpBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{DynamicResource Radar.SellsHour}" />
                            <TextBlock Style="{StaticResource Total}" Text="{Binding WhaleSellsText}" Foreground="{DynamicResource DownBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Settings -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <ToggleButton x:Name="RadarSettingsToggle" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{DynamicResource Radar.Settings}" Margin="8,0,0,0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <StackPanel Margin="2,8,0,0" Visibility="{Binding IsChecked, ElementName=RadarSettingsToggle, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Radar.MinWhale}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource SegmentedPanel}" Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding WhaleOptions}" ItemTemplate="{StaticResource ChoiceSegment}" ItemsPanel="{StaticResource Horizontal}" />
                        </Border>
                        <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Radar.MinLiquidation}" Margin="0,0,0,4" />
                        <Border Style="{StaticResource SegmentedPanel}" Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding LiquidationOptions}" ItemTemplate="{StaticResource ChoiceSegment}" ItemsPanel="{StaticResource Horizontal}" />
                        </Border>
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Radar.OnlyMyCoins}" IsChecked="{Binding RadarOnlyMyCoins}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Radar.Notify}" IsChecked="{Binding NotifyRadar}" />
                        <Border Style="{StaticResource SegmentedPanel}" Margin="0,2,0,4"
                                Visibility="{Binding NotifyRadar, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding NotifyOptions}" ItemTemplate="{StaticResource ChoiceSegment}" ItemsPanel="{StaticResource Horizontal}" />
                        </Border>
                        <TextBlock Style="{StaticResource Small}" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding RadarSources}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Filter -->
                <Border DockPanel.Dock="Top" Style="{StaticResource SegmentedPanel}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="RadarFilter" Content="{DynamicResource Radar.All}" FontSize="11.5"
                                     IsChecked="{Binding RadarFilter, Converter={StaticResource EqualsConverter}, ConverterParameter=All}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="RadarFilter" Content="{DynamicResource Radar.Whales}" FontSize="11.5"
                                     IsChecked="{Binding RadarFilter, Converter={StaticResource EqualsConverter}, ConverterParameter=Whales}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="RadarFilter" Content="{DynamicResource Radar.Liquidations}" FontSize="11.5"
                                     IsChecked="{Binding RadarFilter, Converter={StaticResource EqualsConverter}, ConverterParameter=Liquidations}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                    <Grid>
                        <TextBlock Style="{StaticResource Small}" Text="{Binding RadarStatus}" Margin="12,10" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RadarEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RadarEventViewModel}">
                                        <DockPanel Margin="10,6">
                                            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource UpBrush}" />
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock x:Name="Value" Text="{Binding ValueText}" HorizontalAlignment="Right" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource UpBrush}" Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock FontSize="12.5">
                                                    <Run Text="{Binding Symbol, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding KindText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding DetailText}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsUp}" Value="False">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DownBrush}" />
                                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource DownBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- ================= Fees ================= -->
            <ScrollViewer Visibility="{Binding IsFeesTab, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource Small}" Text="{Binding FeeStatus}" Foreground="{DynamicResource DownBrush}" Margin="2,0,0,6" />

                    <!-- Bitcoin -->
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{DynamicResource Fees.Bitcoin}" />
                            <UniformGrid Columns="4" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Fees.Fastest}" />
                                    <TextBlock Style="{StaticResource Total}" Text="{Binding BtcFastestText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Fees.HalfHour}" />
                                    <TextBlock Style="{StaticResource Total}" Text="{Binding BtcHalfHourText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Fees.Hour}" />
                                    <TextBlock Style="{StaticResource Total}" Text="{Binding BtcHourText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Fees.Economy}" />
                                    <TextBlock Style="{StaticResource Total}" Text="{Binding BtcEconomyText}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding BtcCostText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Ethereum -->
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{DynamicResource Fees.Ethereum}" />
                            <TextBlock Text="{Binding EthTotalText}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Small}">
                                <Run Text="{DynamicResource Fees.Base}" /> <Run Text="{Binding EthBaseText, Mode=OneWay}" />  ·  <Run Text="{DynamicResource Fees.Tip}" /> <Run Text="{Binding EthTipText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding EthCostText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Fee alerts -->
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{DynamicResource Fees.Alerts}" Margin="0,0,0,6" />
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="gwei" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource FieldBox}" Width="90" Tag="{DynamicResource Fees.Off}"
                                         Text="{Binding GasBelowText, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="{DynamicResource Fees.GasBelow}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="sat/vB" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource FieldBox}" Width="90" Tag="{DynamicResource Fees.Off}"
                                         Text="{Binding BtcBelowText, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="{DynamicResource Fees.BtcBelow}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Fees.AlertsHint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Small}" Foreground="{DynamicResource TextTertiaryBrush}" Text="{DynamicResource Fees.Sources}" Margin="2,0,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Calendar ================= -->
            <DockPanel DataContext="{Binding Calendar}"
                       Visibility="{Binding DataContext.IsCalendarTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">

                <!-- Halving countdown -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Tile}"
                        Visibility="{Binding HasHalving, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Margin="10,0,4,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="{DynamicResource Calendar.NextHalving}" />
                            <TextBlock Text="{Binding HalvingCountdown}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                                       Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Style="{StaticResource Small}" Text="{Binding HalvingDate}" />
                            <TextBlock Style="{StaticResource Small}" Text="{Binding HalvingDetail}" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Reminders and filter -->
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                    <TextBlock Style="{StaticResource Small}" Text="{DynamicResource Calendar.Remind}" Margin="0,0,0,4" />
                    <Border Style="{StaticResource SegmentedPanel}" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <ItemsControl ItemsSource="{Binding RemindOptions}" ItemTemplate="{StaticResource ChoiceSegment}" ItemsPanel="{StaticResource Horizontal}" />
                    </Border>
                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Calendar.AllCountries}" IsChecked="{Binding AllCountries}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Small}" Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{DynamicResource Calendar.Sources}" Margin="2,8,0,0" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="2,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Small}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Events, soonest first, with a heading for each day -->
                <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CalendarEventViewModel}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DayText}" Style="{StaticResource TileLabel}" Margin="10,10,0,2"
                                                   Visibility="{Binding ShowDay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" ToolTip="{Binding Event.Source}">
                                            <DockPanel>
                                                <TextBlock x:Name="Countdown" DockPanel.Dock="Right" Text="{Binding CountdownText}" FontSize="11.5"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" Typography.NumeralAlignment="Tabular"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" Width="62" FontSize="11.5" VerticalAlignment="Center"
                                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <Border DockPanel.Dock="Left" CornerRadius="4" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource HoverBrush}"
                                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DetailText}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSoon}" Value="True">
                                            <Setter TargetName="Countdown" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Countdown" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
