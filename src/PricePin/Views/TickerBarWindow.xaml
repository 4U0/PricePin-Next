<Window x:Class="PricePin.Views.TickerBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PricePin.ViewModels"
        xmlns:ctl="clr-namespace:PricePin.Controls"
        Title="PricePin ticker"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Topmost="{Binding Topmost}"
        Opacity="{Binding Opacity}"
        ContextMenu="{StaticResource WidgetMenu}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One coin in the strip: logo, symbol, price, 24h change, then a divider. -->
        <DataTemplate x:Key="TickerItem" DataType="{x:Type vm:CoinRowViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center" ToolTip="{Binding DetailsText}">
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                    <Ellipse Fill="{Binding BadgeBrush}" />
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="9.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PriceText}" FontFamily="{StaticResource DisplayFont}" FontSize="12.5" Margin="7,0,0,0"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource TextPrimaryBrush}" ctl:Flash.Pulse="{Binding FlashPulse}" />
                <TextBlock x:Name="Change" Text="{Binding ChangeText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource UpBrush}" />
                <Ellipse Width="3" Height="3" Margin="18,0,0,0" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUp}" Value="False">
                    <Setter TargetName="Change" Property="Foreground" Value="{DynamicResource DownBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Horizontal">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="Bar" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Border.LayoutTransform>

        <DockPanel Height="34">
            <!-- Live status: just a coloured dot and label; hover for details. -->
            <Border x:Name="Pill" DockPanel.Dock="Left" Margin="10,0,8,0" Padding="7,2,8,2" CornerRadius="9" VerticalAlignment="Center"
                    ToolTip="{Binding App.StatusDetail}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#26F59E0B" />
                        <Setter Property="Tag" Value="#F59E0B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding App.StatusState}" Value="Live">
                                <Setter Property="Background" Value="#2622D399" />
                                <Setter Property="Tag" Value="#22D399" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding App.StatusState}" Value="Polling">
                                <Setter Property="Background" Value="#2638BDF8" />
                                <Setter Property="Tag" Value="#38BDF8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding App.StatusState}" Value="Offline">
                                <Setter Property="Background" Value="#26F43F5E" />
                                <Setter Property="Tag" Value="#F43F5E" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{Binding Tag, ElementName=Pill}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding App.StatusLabel}" Margin="5,0,0,0" FontSize="9.5" FontWeight="Bold"
                               Foreground="{Binding Tag, ElementName=Pill}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Controls that appear on hover. -->
            <StackPanel x:Name="HeaderButtons" DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,6,0" Opacity="0"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Command="{Binding App.OpenSettingsCommand}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Options" Click="MenuButton_Click" Margin="2,0,0,0" />
                <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Hide to tray" Command="{Binding ToggleVisibilityCommand}" Margin="2,0,0,0" />
            </StackPanel>

            <!-- Scrolling strip: two copies side by side so the loop is seamless. -->
            <Canvas x:Name="Viewport" ClipToBounds="True" Height="34" Background="Transparent">
                <StackPanel x:Name="Track" Orientation="Horizontal" Height="34">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="Offset" />
                    </StackPanel.RenderTransform>
                    <ItemsControl x:Name="CopyA" ItemsSource="{Binding Coins}" ItemTemplate="{StaticResource TickerItem}"
                                  ItemsPanel="{StaticResource Horizontal}" Focusable="False" VerticalAlignment="Center" />
                    <ItemsControl x:Name="CopyB" ItemsSource="{Binding Coins}" ItemTemplate="{StaticResource TickerItem}"
                                  ItemsPanel="{StaticResource Horizontal}" Focusable="False" VerticalAlignment="Center" />
                </StackPanel>
            </Canvas>
        </DockPanel>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeaderButtons" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
