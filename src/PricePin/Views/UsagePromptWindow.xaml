<Window x:Class="PricePin.Views.UsagePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Usage.Title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/PricePin.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <StackPanel Margin="22,0,22,20">
        <StackPanel Orientation="Horizontal" Height="44">
            <Image Source="/Assets/PricePin.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Usage.Title}" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{DynamicResource Usage.Body}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,12" />

        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Usage.WhatSent}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Usage.Sent}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Usage.WhatNot}" Margin="0,10,0,4" />
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Usage.NotSent}" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Usage.Later}" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource TextButton}" Content="{DynamicResource Usage.No}" Click="No_Click" Margin="0,0,8,0" />
            <Button Style="{StaticResource AccentButton}" Content="{DynamicResource Usage.Yes}" Click="Yes_Click" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
