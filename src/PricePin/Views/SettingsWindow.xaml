<Window x:Class="PricePin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PricePin.Controls"
        xmlns:vm="clr-namespace:PricePin.ViewModels"
        Title="PricePin Settings"
        Width="760" Height="560" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/PricePin.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ctl:EqualsConverter x:Key="Equals" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Shows a page when Page equals its Tag. -->
        <Style x:Key="PageHost" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="28,4,28,20" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!-- Small round icon button used on list rows. -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <DataTemplate x:Key="LogoTemplate">
            <Grid Width="28" Height="28">
                <Ellipse Fill="{DynamicResource TrackBrush}" />
                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Image Source="/Assets/PricePin.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="PricePin Settings" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
            </StackPanel>

            <!-- Navigation -->
            <DockPanel Grid.Row="1" Margin="12,6,12,14">
                <TextBlock DockPanel.Dock="Bottom" Margin="10,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}">
                    <Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="General"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=General}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8EC;" Content="Coins"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Coins}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE790;" Content="Appearance"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Appearance}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE774;" Content="Data &amp; about"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Data}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Grid.Column="1">

                <!-- ============ General ============ -->
                <ScrollViewer Tag="General">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageHost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="General">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="General" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="WINDOW" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Stay on top of other windows" IsChecked="{Binding Widget.Topmost}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Lock position" IsChecked="{Binding Widget.LockPosition}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Snap to screen edges" IsChecked="{Binding Widget.SnapToEdges}" />
                                <TextBlock Style="{StaticResource Hint}" Text="Hold Shift while dragging to place the widget freely." Margin="0,-2,0,6" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Click-through (mouse passes through the widget)" IsChecked="{Binding Widget.ClickThrough}" />
                                <TextBlock Style="{StaticResource Hint}" Text="Turn it off again from the tray icon or here." Margin="0,-2,0,6" />

                                <DockPanel Margin="0,8,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Widget.OpacityText}" Width="40" TextAlignment="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Opacity" FontSize="13" VerticalAlignment="Center" Width="120" />
                                    <Slider Minimum="{Binding Widget.OpacityMin}" Maximum="{Binding Widget.OpacityMax}"
                                            SmallChange="0.05" LargeChange="0.1" Value="{Binding Widget.Opacity}" Margin="0,0,12,0" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Tip: Ctrl + mouse wheel over the widget changes opacity too." Margin="0,0,0,6" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="STARTUP" />
                        <Border Style="{StaticResource Card}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Start PricePin when Windows starts" IsChecked="{Binding Widget.StartWithWindows}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Coins ============ -->
                <Grid Margin="28,4,28,20">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="Coins">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="3" Text="Coins" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,14" />

                    <!-- Currency -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="SHOW PRICES IN" />
                        <Border Style="{StaticResource SegmentedPanel}">
                            <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.QuoteCurrencies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource Segment}" Content="{Binding}" GroupName="Quote"
                                                     Tag="{Binding}" Loaded="Quote_Loaded" Checked="Quote_Checked" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Binance has no USD pairs, so USD prices come from USDT there. Not every coin trades in every currency." />
                    </StackPanel>

                    <!-- Your coins -->
                    <DockPanel Grid.Row="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Padding="10,4" FontSize="11.5"
                                    Content="Reset to defaults" Command="{Binding ResetCoinsCommand}" />
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Run Text="YOUR COINS" /> <Run Text="{Binding CoinCountText, Mode=OneWay}" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="2,8,0,0"
                                   Text="Drag to reorder. The first coin also shows in the tray tooltip." />
                        <Border Style="{StaticResource Card}" Padding="6" Margin="0">
                            <ListBox x:Name="CoinList" Style="{StaticResource PlainList}" ItemsSource="{Binding SelectedCoins}"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="CoinList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="CoinList_PreviewMouseMove"
                                     DragOver="CoinList_DragOver"
                                     Drop="CoinList_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CoinEntryViewModel}">
                                        <DockPanel Background="Transparent" Cursor="SizeAll">
                                            <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" Opacity="0">
                                                <Button Style="{StaticResource RowButton}" Content="&#xE70E;" ToolTip="Move up"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource RowButton}" Content="&#xE70D;" ToolTip="Move down"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource RowButton}" Content="&#xE711;" ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveCoinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <ContentPresenter ContentTemplate="{StaticResource LogoTemplate}" Content="{Binding}" />
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>

                    <!-- Add coins -->
                    <DockPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="ADD COINS" Margin="2,4,0,10" />
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="Search by name or symbol"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="2,8,0,0" Text="{Binding CatalogStatus}" />

                        <!-- Typed a symbol that isn't listed: offer to add it anyway. -->
                        <Button DockPanel.Dock="Top" Style="{StaticResource TextButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Command="{Binding AddCustomCommand}">
                            <Button.Visibility>
                                <Binding Path="CustomSymbol" TargetNullValue="Collapsed" FallbackValue="Collapsed">
                                    <Binding.Converter>
                                        <ctl:NotNullToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Button.Visibility>
                            <TextBlock>
                                <Run Text="Add" /> <Run Text="{Binding CustomSymbol, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="anyway" />
                            </TextBlock>
                        </Button>

                        <Border Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0">
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding SearchResults}"
                                     VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="SearchResults_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CatalogItemViewModel}">
                                        <DockPanel Background="Transparent">
                                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Button x:Name="AddButton" Style="{StaticResource RowButton}" Content="&#xE710;" ToolTip="Add"
                                                        Command="{Binding DataContext.AddCoinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock x:Name="AddedMark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Already added" />
                                            </Grid>
                                            <ContentPresenter ContentTemplate="{StaticResource LogoTemplate}" Content="{Binding}" />
                                            <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Symbol, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Exchanges}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                <Setter TargetName="AddButton" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="AddedMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- ============ Appearance ============ -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageHost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="Appearance">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="THEME" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="0,6">
                                <Border Style="{StaticResource SegmentedPanel}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="Follow Windows" GroupName="Theme"
                                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Dark" GroupName="Theme"
                                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="Light" GroupName="Theme"
                                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Accent colour" FontSize="13" Margin="0,16,0,8" />
                                <ItemsControl ItemsSource="{Binding AccentOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AccentOption}">
                                            <RadioButton Style="{StaticResource Swatch}" Background="{Binding Brush}" ToolTip="{Binding Name}"
                                                         GroupName="Accent" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                         Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="WIDGET" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,6,0,8">
                                    <TextBlock Text="Size" FontSize="13" VerticalAlignment="Center" Width="120" />
                                    <Border Style="{StaticResource SegmentedPanel}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="Small" GroupName="Size"
                                                         IsChecked="{Binding Widget.Size, Converter={StaticResource Equals}, ConverterParameter=Small}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="Medium" GroupName="Size"
                                                         IsChecked="{Binding Widget.Size, Converter={StaticResource Equals}, ConverterParameter=Medium}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="Large" GroupName="Size"
                                                         IsChecked="{Binding Widget.Size, Converter={StaticResource Equals}, ConverterParameter=Large}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Show coin names" IsChecked="{Binding Widget.ShowNames}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Show 24h sparklines" IsChecked="{Binding Widget.ShowSparklines}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="Show column headings" IsChecked="{Binding Widget.ShowColumnHeadings}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Data & about ============ -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageHost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="Data">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="Data &amp; about" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="DATA SOURCE" />
                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Widget.DataSourceOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DataSourceOption}">
                                            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Source"
                                                         IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Reconnect" Command="{Binding Widget.ReconnectCommand}" />
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="2,0,12,0">
                                        <Run Text="{Binding Widget.StatusLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Widget.StatusDetail, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="ABOUT" />
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <TextBlock FontSize="13" TextWrapping="Wrap">
                                    <Run Text="PricePin" FontWeight="SemiBold" /> <Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                           Text="Free and open source (MIT). No account, no tracking: prices come straight from public exchange feeds. Coin logos from cryptocurrency-icons (CC0) and CoinGecko." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TextButton}" Content="Project page on GitHub" Command="{Binding OpenProjectPageCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource TextButton}" Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
