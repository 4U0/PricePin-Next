<Window x:Class="PricePin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PricePin.Controls"
        xmlns:vm="clr-namespace:PricePin.ViewModels"
        Title="{DynamicResource Settings.Title}"
        Width="760" Height="560" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/PricePin.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ctl:EqualsConverter x:Key="Equals" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Shows a page when Page equals its Tag. -->
        <Style x:Key="PageHost" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="28,4,28,20" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!-- Small round icon button used on list rows. -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- Which widget is being edited, plus add/remove. DataContext: SettingsViewModel. -->
        <DataTemplate x:Key="WidgetPicker">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource TextButton}" Padding="10,5" FontSize="11.5" Margin="6,0,0,0"
                            Command="{Binding AddListWidgetCommand}" IsEnabled="{Binding CanAddWidget}" Content="{DynamicResource Picker.AddList}" />
                    <Button Style="{StaticResource TextButton}" Padding="10,5" FontSize="11.5" Margin="6,0,0,0"
                            Command="{Binding AddTickerBarCommand}" IsEnabled="{Binding CanAddWidget}" Content="{DynamicResource Picker.AddBar}" />
                    <Button Style="{StaticResource TextButton}" Padding="10,5" FontSize="11.5" Margin="6,0,0,0"
                            Command="{Binding RemoveWidgetCommand}" IsEnabled="{Binding CanRemoveWidget}" Content="{DynamicResource Common.Remove}" />
                </StackPanel>
                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding App.Widgets}" SelectedItem="{Binding SelectedWidget}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WidgetViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon" Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsTickerBar}" Value="True">
                                    <Setter TargetName="Icon" Property="Text" Value="&#xE8A0;" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="LogoTemplate">
            <Grid Width="28" Height="28">
                <Ellipse Fill="{DynamicResource TrackBrush}" />
                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Image Source="/Assets/PricePin.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{DynamicResource Settings.Title}" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="{DynamicResource Common.Minimize}" Click="Minimize_Click" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" ToolTip="{DynamicResource Common.Close}" Click="Close_Click" />
            </StackPanel>

            <!-- Navigation -->
            <DockPanel Grid.Row="1" Margin="12,6,12,14">
                <TextBlock DockPanel.Dock="Bottom" Margin="10,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}">
                    <Run Text="{DynamicResource Settings.Version}" /> <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{DynamicResource Nav.General}"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=General}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE737;" Content="{DynamicResource Nav.Widgets}"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Widgets}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8EC;" Content="{DynamicResource Nav.Coins}"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Coins}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA8F;" Content="{DynamicResource Nav.Alerts}"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Alerts}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE790;" Content="{DynamicResource Nav.Appearance}"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Appearance}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE774;" Content="{DynamicResource Nav.Data}"
                                 IsChecked="{Binding Page, Converter={StaticResource Equals}, ConverterParameter=Data}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Grid.Column="1">

                <!-- ============ General ============ -->
                <ScrollViewer Tag="General">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageHost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="General">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav.General}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource General.Startup}" />
                        <Border Style="{StaticResource Card}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource General.StartWithWindows}" IsChecked="{Binding App.StartWithWindows}" />
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource General.Language}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="0,6">
                                <Border Style="{StaticResource SegmentedPanel}" HorizontalAlignment="Left">
                                    <ItemsControl ItemsSource="{Binding App.LanguageOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Segment}" GroupName="Language" Content="{Binding Label}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{DynamicResource General.LanguageHint}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource General.Updates}" />
                        <Border Style="{StaticResource Card}" DataContext="{Binding App.Updates}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource General.AutoUpdate}" IsChecked="{Binding AutoUpdate}"
                                          Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" Text="{Binding StatusText}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TextButton}" Content="{DynamicResource Update.CheckNow}" Command="{Binding CheckNowCommand}"
                                            IsEnabled="{Binding CanCheck}" Margin="0,0,8,0"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource TextButton}" Content="{DynamicResource Update.Download}" Command="{Binding DownloadCommand}"
                                            Margin="0,0,8,0" Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource AccentButton}" Content="{DynamicResource Update.Restart}" Command="{Binding RestartCommand}"
                                            Margin="0,0,8,0" Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource TextButton}" Content="GitHub Releases" Command="{Binding OpenReleasesCommand}"
                                            Visibility="{Binding IsPortable, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource General.Shortcuts}" />
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <DockPanel Margin="0,4">
                                    <TextBox x:Name="HotkeyWidgets" DockPanel.Dock="Right" Width="180" Style="{StaticResource FieldBox}" IsReadOnly="True"
                                             Tag="{DynamicResource General.PressShortcut}" Text="{Binding App.HotkeyToggleWidgets, Mode=OneWay}"
                                             PreviewKeyDown="Hotkey_PreviewKeyDown" IsReadOnlyCaretVisible="False" />
                                    <TextBlock Text="{DynamicResource General.ToggleWidgets}" FontSize="13" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBox x:Name="HotkeyClickThrough" DockPanel.Dock="Right" Width="180" Style="{StaticResource FieldBox}" IsReadOnly="True"
                                             Tag="{DynamicResource General.PressShortcut}" Text="{Binding App.HotkeyToggleClickThrough, Mode=OneWay}"
                                             PreviewKeyDown="Hotkey_PreviewKeyDown" IsReadOnlyCaretVisible="False" />
                                    <TextBlock Text="{DynamicResource General.ToggleClickThrough}" FontSize="13" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="{DynamicResource General.ShortcutHint}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Foreground="{DynamicResource DownBrush}"
                                           Text="{Binding App.HotkeyWarning}">
                                    <TextBlock.Visibility>
                                        <Binding Path="App.HotkeyWarning">
                                            <Binding.Converter>
                                                <ctl:NotNullToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Widgets ============ -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageHost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="Widgets">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav.Widgets}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,6" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Text="{DynamicResource Widgets.Intro}" />

                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetPicker}" Margin="0,0,0,14" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Widgets.This}" />
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <DockPanel Margin="0,4,0,8">
                                    <TextBlock Text="{DynamicResource Widgets.Name}" FontSize="13" VerticalAlignment="Center" Width="120" />
                                    <TextBox Style="{StaticResource FieldBox}" MaxLength="40"
                                             Text="{Binding SelectedWidget.Name, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </DockPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="{DynamicResource Widgets.Layout}" FontSize="13" VerticalAlignment="Center" Width="120" />
                                    <Border Style="{StaticResource SegmentedPanel}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Widgets.List}" GroupName="Layout"
                                                         IsChecked="{Binding SelectedWidget.Layout, Converter={StaticResource Equals}, ConverterParameter=List}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Widgets.Bar}" GroupName="Layout"
                                                         IsChecked="{Binding SelectedWidget.Layout, Converter={StaticResource Equals}, ConverterParameter=TickerBar}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <DockPanel Margin="0,8,0,4">
                                    <TextBlock Text="{DynamicResource Widgets.Size}" FontSize="13" VerticalAlignment="Center" Width="120" />
                                    <Border Style="{StaticResource SegmentedPanel}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Widgets.Small}" GroupName="Size"
                                                         IsChecked="{Binding SelectedWidget.Size, Converter={StaticResource Equals}, ConverterParameter=Small}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Widgets.Medium}" GroupName="Size"
                                                         IsChecked="{Binding SelectedWidget.Size, Converter={StaticResource Equals}, ConverterParameter=Medium}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Widgets.Large}" GroupName="Size"
                                                         IsChecked="{Binding SelectedWidget.Size, Converter={StaticResource Equals}, ConverterParameter=Large}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Widgets.Show}" IsChecked="{Binding SelectedWidget.IsWidgetVisible}" />
                            </StackPanel>
                        </Border>

                        <!-- Ticker bar options -->
                        <StackPanel Visibility="{Binding SelectedWidget.IsTickerBar, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Widgets.BarSection}" />
                            <Border Style="{StaticResource Card}" Padding="16,12">
                                <StackPanel>
                                    <DockPanel Margin="0,4,0,8">
                                        <TextBlock Text="{DynamicResource Widgets.Position}" FontSize="13" VerticalAlignment="Center" Width="120" />
                                        <Border Style="{StaticResource SegmentedPanel}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Widgets.Top}" GroupName="Dock"
                                                             IsChecked="{Binding SelectedWidget.Dock, Converter={StaticResource Equals}, ConverterParameter=Top}" />
                                                <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Widgets.Bottom}" GroupName="Dock"
                                                             IsChecked="{Binding SelectedWidget.Dock, Converter={StaticResource Equals}, ConverterParameter=Bottom}" />
                                                <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Widgets.Floating}" GroupName="Dock"
                                                             IsChecked="{Binding SelectedWidget.Dock, Converter={StaticResource Equals}, ConverterParameter=Floating}" />
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                    <CheckBox Content="{DynamicResource Widgets.Reserve}"
                                              IsChecked="{Binding SelectedWidget.ReserveSpace}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedWidget.IsFloating}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <DockPanel Margin="0,8,0,4" Visibility="{Binding SelectedWidget.IsFloating, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding SelectedWidget.FloatingWidth, StringFormat={}{0:0} px}" />
                                        <TextBlock Text="{DynamicResource Widgets.Width}" FontSize="13" VerticalAlignment="Center" Width="120" />
                                        <Slider Minimum="320" Maximum="2400" SmallChange="20" LargeChange="100"
                                                Value="{Binding SelectedWidget.FloatingWidth, Delay=250}" Margin="0,0,12,0" />
                                    </DockPanel>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Widgets.Scroll}" IsChecked="{Binding SelectedWidget.Scroll}" />
                                    <DockPanel Margin="0,4" Visibility="{Binding SelectedWidget.Scroll, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{DynamicResource Widgets.Speed}" FontSize="13" VerticalAlignment="Center" Width="120" />
                                        <Slider Minimum="10" Maximum="150" SmallChange="5" LargeChange="20" Value="{Binding SelectedWidget.ScrollSpeed}" Margin="0,0,12,0" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Widgets.ScrollHint}" Margin="0,4,0,4" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- List options -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedWidget.IsTickerBar}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Widgets.ListSection}" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Widgets.ShowNames}" IsChecked="{Binding SelectedWidget.ShowNames}" />
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Widgets.ShowSparklines}" IsChecked="{Binding SelectedWidget.ShowSparklines}" />
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Widgets.ShowHeadings}" IsChecked="{Binding SelectedWidget.ShowColumnHeadings}" />
                                    <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Common.Snap}" IsChecked="{Binding SelectedWidget.SnapToEdges}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Common.SnapTip}" Margin="0,-2,0,6" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Widgets.Window}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Widgets.Topmost}" IsChecked="{Binding SelectedWidget.Topmost}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Common.Lock}" IsChecked="{Binding SelectedWidget.LockPosition}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Widgets.ClickThrough}" IsChecked="{Binding SelectedWidget.ClickThrough}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,-2,0,6">
                                    <Run Text="{Binding App.ClickThroughOffHint, Mode=OneWay}" />
                                </TextBlock>
                                <DockPanel Margin="0,8,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedWidget.OpacityText}" Width="40" TextAlignment="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Common.Opacity}" FontSize="13" VerticalAlignment="Center" Width="120" />
                                    <Slider Minimum="{Binding SelectedWidget.OpacityMin}" Maximum="{Binding SelectedWidget.OpacityMax}"
                                            SmallChange="0.05" LargeChange="0.1" Value="{Binding SelectedWidget.Opacity}" Margin="0,0,12,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Coins ============ -->
                <Grid Margin="28,4,28,20">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="Coins">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="3" Margin="0,4,0,8">
                        <TextBlock Text="{DynamicResource Nav.Coins}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WidgetPicker}" />
                    </StackPanel>

                    <!-- Currency -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Coins.ShowIn}" />
                        <Border Style="{StaticResource SegmentedPanel}">
                            <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.QuoteCurrencies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource Segment}" Content="{Binding}" GroupName="Quote"
                                                     Tag="{Binding}" Loaded="Quote_Loaded" Checked="Quote_Checked" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="{DynamicResource Coins.QuoteHint}" />
                    </StackPanel>

                    <!-- Your coins -->
                    <DockPanel Grid.Row="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Padding="10,4" FontSize="11.5"
                                    Content="{DynamicResource Coins.Reset}" Command="{Binding ResetCoinsCommand}" />
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Run Text="{DynamicResource Coins.Yours}" /> <Run Text="{Binding CoinCountText, Mode=OneWay}" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="2,8,0,0"
                                   Text="{DynamicResource Coins.DragHint}" />
                        <Border Style="{StaticResource Card}" Padding="6" Margin="0">
                            <ListBox x:Name="CoinList" Style="{StaticResource PlainList}" ItemsSource="{Binding SelectedCoins}"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="CoinList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="CoinList_PreviewMouseMove"
                                     DragOver="CoinList_DragOver"
                                     Drop="CoinList_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CoinEntryViewModel}">
                                        <DockPanel Background="Transparent" Cursor="SizeAll">
                                            <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" Opacity="0">
                                                <Button Style="{StaticResource RowButton}" Content="&#xE70E;" ToolTip="{DynamicResource Common.MoveUp}"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource RowButton}" Content="&#xE70D;" ToolTip="{DynamicResource Common.MoveDown}"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource RowButton}" Content="&#xE711;" ToolTip="{DynamicResource Common.Remove}"
                                                        Command="{Binding DataContext.RemoveCoinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <ContentPresenter ContentTemplate="{StaticResource LogoTemplate}" Content="{Binding}" />
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>

                    <!-- Add coins -->
                    <DockPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{DynamicResource Coins.Add}" Margin="2,4,0,10" />
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="{DynamicResource Coins.Search}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="2,8,0,0" Text="{Binding CatalogStatus}" />

                        <!-- Typed a symbol that isn't listed: offer to add it anyway. -->
                        <Button DockPanel.Dock="Top" Style="{StaticResource TextButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Command="{Binding AddCustomCommand}">
                            <Button.Visibility>
                                <Binding Path="CustomSymbol" TargetNullValue="Collapsed" FallbackValue="Collapsed">
                                    <Binding.Converter>
                                        <ctl:NotNullToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Button.Visibility>
                            <TextBlock>
                                <Run Text="{Binding AddCustomText, Mode=OneWay}" />
                            </TextBlock>
                        </Button>

                        <Border Style="{StaticResource Card}" Padding="6" Margin="0,8,0,0">
                            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding SearchResults}"
                                     VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="SearchResults_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CatalogItemViewModel}">
                                        <DockPanel Background="Transparent">
                                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Button x:Name="AddButton" Style="{StaticResource RowButton}" Content="&#xE710;" ToolTip="{DynamicResource Common.Add}"
                                                        Command="{Binding DataContext.AddCoinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock x:Name="AddedMark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{DynamicResource Coins.Already}" />
                                            </Grid>
                                            <ContentPresenter ContentTemplate="{StaticResource LogoTemplate}" Content="{Binding}" />
                                            <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Symbol, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Exchanges}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                <Setter TargetName="AddButton" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="AddedMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- ============ Alerts ============ -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageHost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="Alerts">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel DataContext="{Binding App.Alerts}">
                        <TextBlock Text="{DynamicResource Nav.Alerts}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Alerts.New}" />
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="{DynamicResource Alerts.Coin}" Width="90" FontSize="13" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource FieldBox}" Width="110" CharacterCasing="Upper" MaxLength="12"
                                             Text="{Binding NewSymbol, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    <ItemsControl ItemsSource="{Binding SymbolChoices}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource TextButton}" Padding="7,2" Margin="0,2,4,2" FontSize="11"
                                                        Content="{Binding}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.PickSymbolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                                <DockPanel Margin="0,8,0,4">
                                    <TextBlock Text="{DynamicResource Alerts.When}" Width="90" FontSize="13" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource SegmentedPanel}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="AlertCondition" Content="{DynamicResource Alerts.Above}"
                                                         IsChecked="{Binding NewCondition, Converter={StaticResource Equals}, ConverterParameter=Above}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="AlertCondition" Content="{DynamicResource Alerts.Below}"
                                                         IsChecked="{Binding NewCondition, Converter={StaticResource Equals}, ConverterParameter=Below}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="AlertCondition" Content="{DynamicResource Alerts.Rises}"
                                                         IsChecked="{Binding NewCondition, Converter={StaticResource Equals}, ConverterParameter=RisesBy}" />
                                            <RadioButton Style="{StaticResource Segment}" GroupName="AlertCondition" Content="{DynamicResource Alerts.Falls}"
                                                         IsChecked="{Binding NewCondition, Converter={StaticResource Equals}, ConverterParameter=FallsBy}" />
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <DockPanel Margin="0,8,0,4">
                                    <TextBlock Text="{DynamicResource Alerts.Value}" Width="90" FontSize="13" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource FieldBox}" Width="160" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding ValueSuffix}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding CurrentPriceText}" Margin="14,0,0,0" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </DockPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,6,0,0" Content="{DynamicResource Alerts.RepeatLabel}"
                                          IsChecked="{Binding NewRepeat}" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Content="{DynamicResource Alerts.AddButton}"
                                            Command="{Binding AddCommand}" />
                                    <TextBlock Text="{Binding NewError}" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DownBrush}" TextWrapping="Wrap" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Alerts.Yours}" />
                        <Border Style="{StaticResource Card}" Padding="8,6">
                            <StackPanel>
                                <TextBlock Margin="8,8" Text="{DynamicResource Alerts.Empty}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AlertItemViewModel}">
                                            <DockPanel Margin="4,5">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="&#xE74D;"
                                                        ToolTip="{DynamicResource Common.Remove}" Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"
                                                          VerticalAlignment="Center" Margin="8,0" />
                                                <ContentPresenter ContentTemplate="{StaticResource LogoTemplate}" Content="{Binding}" VerticalAlignment="Center" />
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" Content="{DynamicResource Alerts.Sound}" IsChecked="{Binding AlertSound}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6" Text="{DynamicResource Alerts.Hint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Appearance ============ -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageHost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="Appearance">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav.Appearance}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Appearance.Theme}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="0,6">
                                <Border Style="{StaticResource SegmentedPanel}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Appearance.System}" GroupName="Theme"
                                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Appearance.Dark}" GroupName="Theme"
                                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="{DynamicResource Appearance.Light}" GroupName="Theme"
                                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{DynamicResource Appearance.Accent}" FontSize="13" Margin="0,16,0,8" />
                                <ItemsControl ItemsSource="{Binding AccentOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AccentOption}">
                                            <RadioButton Style="{StaticResource Swatch}" Background="{Binding Brush}" ToolTip="{Binding Name}"
                                                         GroupName="Accent" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                         Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Tray.Title}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="0,6">
                                <ItemsControl ItemsSource="{Binding App.TrayCoinOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="TrayCoin" Margin="0,0,6,6" Padding="10,5"
                                                         Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{DynamicResource Tray.Hint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Data & about ============ -->
                <ScrollViewer>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource PageHost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="Data">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav.Data}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,18" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Data.Source}" />
                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding App.DataSourceOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DataSourceOption}">
                                            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Source"
                                                         IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="{DynamicResource Common.Reconnect}" Command="{Binding App.ReconnectCommand}" />
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="2,0,12,0">
                                        <Run Text="{Binding App.StatusLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="·" />
                                        <Run Text="{Binding App.StatusDetail, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Data.About}" />
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <TextBlock FontSize="13" TextWrapping="Wrap">
                                    <Run Text="PricePin" FontWeight="SemiBold" /> <Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                           Text="{DynamicResource Data.AboutText}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TextButton}" Content="{DynamicResource Data.Project}" Command="{Binding OpenProjectPageCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource TextButton}" Content="{DynamicResource Data.OpenFolder}" Command="{Binding OpenSettingsFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
