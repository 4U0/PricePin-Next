<Window x:Class="PricePin.Views.CoinDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PricePin.Controls"
        Title="{Binding Title}"
        Width="700" Height="500" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="/Assets/PricePin.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ctl:EqualsConverter x:Key="Equals" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Margin="16,0,6,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="{DynamicResource Common.Minimize}" Click="Minimize_Click" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" ToolTip="{DynamicResource Common.Close}" Click="Close_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="22" Height="22">
                    <Ellipse Fill="{Binding BadgeBrush}" />
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Logo}" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <TextBlock Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center">
                    <Run Text="{Binding Symbol, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Price and range -->
        <DockPanel Grid.Row="1" Margin="22,4,22,10">
            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentedPanel}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="{DynamicResource Detail.Day}"
                                 IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Day}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="{DynamicResource Detail.Week}"
                                 IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Week}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="{DynamicResource Detail.Month}"
                                 IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Month}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="{DynamicResource Detail.Year}"
                                 IsChecked="{Binding Range, Converter={StaticResource Equals}, ConverterParameter=Year}" />
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding PriceText}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="{Binding ChangeText}" FontSize="12.5" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource UpBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUp}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DownBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Chart -->
        <Border Grid.Row="2" Margin="16,0,16,8" Padding="12,10,6,4" CornerRadius="12"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <ctl:PriceChart x:Name="Chart" Candles="{Binding Chart}" PriceFormatter="{Binding PriceFormatter}"
                                ShowTimeOfDay="{Binding IsDay}"
                                LabelBrush="{DynamicResource TextTertiaryBrush}" GridBrush="{DynamicResource DividerBrush}"
                                TextBrush="{DynamicResource TextPrimaryBrush}" PopupBrush="{DynamicResource MenuSurfaceBrush}">
                    <ctl:PriceChart.Style>
                        <Style TargetType="ctl:PriceChart">
                            <Setter Property="LineColor" Value="{DynamicResource UpColor}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChartUp}" Value="False">
                                    <Setter Property="LineColor" Value="{DynamicResource DownColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ctl:PriceChart.Style>
                </ctl:PriceChart>
                <TextBlock Text="{DynamicResource Detail.Loading}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Message}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="360" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Stats and actions -->
        <DockPanel Grid.Row="3" Margin="22,4,22,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TextButton}" Content="{DynamicResource Detail.SetAlert}" Command="{Binding SetAlertCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource TextButton}" Content="{DynamicResource Detail.AddHolding}" Command="{Binding AddHoldingCommand}" />
            </StackPanel>
            <WrapPanel>
                <StackPanel Margin="0,0,26,0">
                    <TextBlock Style="{StaticResource StatLabel}" Text="{DynamicResource Detail.High}" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding HighText}" />
                </StackPanel>
                <StackPanel Margin="0,0,26,0">
                    <TextBlock Style="{StaticResource StatLabel}" Text="{DynamicResource Detail.Low}" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding LowText}" />
                </StackPanel>
                <StackPanel Margin="0,0,26,0">
                    <TextBlock Style="{StaticResource StatLabel}" Text="{DynamicResource Detail.Change}" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding RangeChangeText}" />
                </StackPanel>
                <StackPanel Margin="0,0,26,0">
                    <TextBlock Style="{StaticResource StatLabel}" Text="{DynamicResource Detail.Volume}" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding VolumeText}" />
                </StackPanel>
                <TextBlock Text="{Binding SourceText}" FontSize="10.5" VerticalAlignment="Bottom" Margin="0,0,0,2"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
