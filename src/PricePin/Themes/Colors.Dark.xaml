<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Dark palette. Every theme defines the same keys; ThemeService swaps the whole dictionary. -->
    <Color x:Key="SurfaceColor">#F2121722</Color>
    <Color x:Key="MenuSurfaceColor">#FA181E2B</Color>
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="UpColor">#22D399</Color>
    <Color x:Key="DownColor">#F43F5E</Color>
    <sys:Double x:Key="ShadowOpacity">0.55</sys:Double>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="MenuSurfaceBrush" Color="{StaticResource MenuSurfaceColor}" />

    <!-- Card: faint top-to-bottom gradient with a lighter top edge, like frosted glass. -->
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5182030" Offset="0" />
        <GradientStop Color="#F20E121B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B" />

    <SolidColorBrush x:Key="UpBrush" Color="{StaticResource UpColor}" />
    <SolidColorBrush x:Key="UpSoftBrush" Color="#1F22D399" />
    <SolidColorBrush x:Key="DownBrush" Color="{StaticResource DownColor}" />
    <SolidColorBrush x:Key="DownSoftBrush" Color="#1FF43F5E" />

    <!-- Settings window -->
    <SolidColorBrush x:Key="WindowBrush" Color="#0E121A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#151B27" />
    <SolidColorBrush x:Key="InputBrush" Color="#0B0F16" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2A3344" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#06281D" />
</ResourceDictionary>
