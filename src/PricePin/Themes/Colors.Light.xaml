<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Light palette. Every theme defines the same keys; ThemeService swaps the whole dictionary. -->
    <Color x:Key="SurfaceColor">#F7FFFFFF</Color>
    <Color x:Key="MenuSurfaceColor">#FCFFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="UpColor">#059669</Color>
    <Color x:Key="DownColor">#E11D48</Color>
    <sys:Double x:Key="ShadowOpacity">0.22</sys:Double>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="MenuSurfaceBrush" Color="{StaticResource MenuSurfaceColor}" />

    <!-- Card: faint top-to-bottom gradient with a lighter top edge, like frosted glass. -->
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFFFFFF" Offset="0" />
        <GradientStop Color="#F5F1F4F9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24000000" Offset="0" />
        <GradientStop Color="#14000000" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
    <SolidColorBrush x:Key="TrackBrush" Color="#26000000" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8" />

    <SolidColorBrush x:Key="UpBrush" Color="{StaticResource UpColor}" />
    <SolidColorBrush x:Key="UpSoftBrush" Color="#1F059669" />
    <SolidColorBrush x:Key="DownBrush" Color="{StaticResource DownColor}" />
    <SolidColorBrush x:Key="DownSoftBrush" Color="#1FE11D48" />

    <!-- Settings window -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
</ResourceDictionary>
