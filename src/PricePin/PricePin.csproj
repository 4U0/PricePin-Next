<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PricePin</AssemblyName>
    <RootNamespace>PricePin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PricePin.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>PricePin.Program</StartupObject>
    <!-- Ship only the languages PricePin is translated into (drops ~15 framework resource folders). -->
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PricePin.ico" />
    <Resource Include="Assets\Coins\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PricePin.Core\PricePin.Core.csproj" />
  </ItemGroup>

  <!-- Release builds get the analytics key from CI (-p:AptabaseKey=...); local builds have none
       and never send usage pings. -->
  <ItemGroup>
    <AssemblyMetadata Include="AptabaseKey" Value="$(AptabaseKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
