<Application x:Class="PricePin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Forms.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!--
            The menu shown when right-clicking the widget or the tray icon.
            x:Shared="False" gives each owner its own copy. DataContext is the WidgetViewModel.
        -->
        <ContextMenu x:Key="AppMenu" x:Shared="False">
            <MenuItem Command="{Binding ToggleVisibilityCommand}" Tag="&#xE7B3;">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="Hide widget" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWidgetVisible}" Value="False">
                                <Setter Property="Header" Value="Show widget" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem Header="Settings…" Tag="&#xE713;" Command="{Binding OpenSettingsCommand}" />
            <Separator />
            <MenuItem Header="Data source" Tag="&#xE774;" ItemsSource="{Binding DataSourceOptions}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                        <Setter Property="Command" Value="{Binding SelectCommand}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Reconnect" Tag="&#xE72C;" Command="{Binding ReconnectCommand}" />
            <Separator />
            <MenuItem Header="Stay on top" Tag="&#xE718;" IsCheckable="True" IsChecked="{Binding Topmost}" />
            <MenuItem StaysOpenOnClick="True" Tag="&#xE793;">
                <MenuItem.Header>
                    <StackPanel Width="170">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Opacity" />
                        </DockPanel>
                        <Slider Minimum="{Binding OpacityMin}" Maximum="{Binding OpacityMax}"
                                SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding Opacity}" Margin="0,2,0,0" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="Click-through" Tag="&#xE8B0;" IsCheckable="True" IsChecked="{Binding ClickThrough}"
                      InputGestureText="off via tray"
                      ToolTip="The mouse passes through the widget. Turn it off from the tray icon." />
            <MenuItem Header="Lock position" Tag="&#xE72E;" IsCheckable="True" IsChecked="{Binding LockPosition}" />
            <MenuItem Header="Snap to screen edges" Tag="&#xE8A9;" IsCheckable="True" IsChecked="{Binding SnapToEdges}"
                      ToolTip="Hold Shift while dragging to place the widget freely." />
            <Separator />
            <MenuItem Header="Start with Windows" Tag="&#xE7E8;" IsCheckable="True" IsChecked="{Binding StartWithWindows}" />
            <Separator />
            <MenuItem Header="Exit PricePin" Tag="&#xE711;" Command="{Binding ExitCommand}" />
        </ContextMenu>
        </ResourceDictionary>
    </Application.Resources>
</Application>
