<Application x:Class="PricePin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PricePin.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Forms.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <ctl:EqualsConverter x:Key="EqualsConverter" />

        <!-- Right-click menu of a widget. DataContext: WidgetViewModel. x:Shared="False": one copy per widget. -->
        <ContextMenu x:Key="WidgetMenu" x:Shared="False">
            <MenuItem Header="{DynamicResource Menu.HideWidget}" Tag="&#xE7B3;" Command="{Binding ToggleVisibilityCommand}" />
            <MenuItem Header="{DynamicResource Menu.Settings}" Tag="&#xE713;" Command="{Binding App.OpenSettingsCommand}" />
            <MenuItem Header="{DynamicResource Menu.Alerts}" Tag="&#xEA8F;" Command="{Binding App.OpenAlertsCommand}" />
            <MenuItem Header="{DynamicResource Menu.Market}" Tag="&#xE9D2;" Command="{Binding App.OpenMarketCommand}" />
            <MenuItem Header="{DynamicResource Menu.QuickSearch}" Tag="&#xE721;" Command="{Binding App.OpenQuickSearchCommand}"
                      InputGestureText="{Binding App.HotkeyQuickSearch}" />
            <Separator />
            <MenuItem Header="{DynamicResource Menu.ShowChange}" Tag="&#xE9D9;">
                <MenuItem Header="{DynamicResource Period.HourLong}" Command="{Binding SetChangePeriodCommand}" CommandParameter="Hour"
                          IsChecked="{Binding ChangePeriod, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Hour}" />
                <MenuItem Header="{DynamicResource Period.DayLong}" Command="{Binding SetChangePeriodCommand}" CommandParameter="Day"
                          IsChecked="{Binding ChangePeriod, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Day}" />
                <MenuItem Header="{DynamicResource Period.WeekLong}" Command="{Binding SetChangePeriodCommand}" CommandParameter="Week"
                          IsChecked="{Binding ChangePeriod, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Week}" />
            </MenuItem>
            <MenuItem Tag="&#xE8A9;" Command="{Binding SwitchLayoutCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{DynamicResource Menu.SwitchToBar}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTickerBar}" Value="True">
                                <Setter Property="Header" Value="{DynamicResource Menu.SwitchToList}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Topmost}" Tag="&#xE718;" IsCheckable="True" IsChecked="{Binding Topmost}" />
            <MenuItem StaysOpenOnClick="True" Tag="&#xE793;">
                <MenuItem.Header>
                    <StackPanel Width="170">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{DynamicResource Common.Opacity}" />
                        </DockPanel>
                        <Slider Minimum="{Binding OpacityMin}" Maximum="{Binding OpacityMax}"
                                SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding Opacity}" Margin="0,2,0,0" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.ClickThrough}" Tag="&#xE8B0;" IsCheckable="True" IsChecked="{Binding ClickThrough}"
                      InputGestureText="{DynamicResource Menu.ClickThroughGesture}"
                      ToolTip="{DynamicResource Menu.ClickThroughTip}" />
            <MenuItem Header="{DynamicResource Common.Lock}" Tag="&#xE72E;" IsCheckable="True" IsChecked="{Binding LockPosition}" />
            <MenuItem Header="{DynamicResource Menu.Privacy}" Tag="&#xED1A;" IsCheckable="True" IsChecked="{Binding App.Portfolio.PrivacyMode}" />
            <MenuItem Header="{DynamicResource Common.Snap}" Tag="&#xE8A9;" IsCheckable="True" IsChecked="{Binding SnapToEdges}"
                      ToolTip="{DynamicResource Common.SnapTip}" />
            <Separator />
            <MenuItem Header="{DynamicResource Menu.Exit}" Tag="&#xE711;" Command="{Binding App.ExitCommand}" />
        </ContextMenu>

        <!-- Tray icon menu. DataContext: AppViewModel. -->
        <ContextMenu x:Key="TrayMenu" x:Shared="False">
            <MenuItem Tag="&#xE7B3;" Command="{Binding ToggleAllWidgetsCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{DynamicResource Menu.HideWidgets}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AnyWidgetVisible}" Value="False">
                                <Setter Property="Header" Value="{DynamicResource Menu.ShowWidgets}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.ClickThrough}" Tag="&#xE8B0;" IsCheckable="True" IsChecked="{Binding AnyClickThrough, Mode=OneWay}"
                      Command="{Binding ToggleClickThroughAllCommand}" />
            <MenuItem Header="{DynamicResource Menu.Settings}" Tag="&#xE713;" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="{DynamicResource Menu.Alerts}" Tag="&#xEA8F;" Command="{Binding OpenAlertsCommand}" />
            <MenuItem Header="{DynamicResource Menu.Market}" Tag="&#xE9D2;" Command="{Binding OpenMarketCommand}" />
            <MenuItem Header="{DynamicResource Menu.QuickSearch}" Tag="&#xE721;" Command="{Binding OpenQuickSearchCommand}"
                      InputGestureText="{Binding HotkeyQuickSearch}" />
            <MenuItem Header="{DynamicResource Menu.Privacy}" Tag="&#xED1A;" IsCheckable="True" IsChecked="{Binding Portfolio.PrivacyMode}" />
            <Separator />
            <MenuItem Header="{DynamicResource Menu.DataSource}" Tag="&#xE774;" ItemsSource="{Binding DataSourceOptions}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                        <Setter Property="Command" Value="{Binding SelectCommand}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="{DynamicResource Common.Reconnect}" Tag="&#xE72C;" Command="{Binding ReconnectCommand}" />
            <MenuItem Tag="&#xE777;" Header="{Binding Updates.RestartMenuText}" Command="{Binding Updates.RestartCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Updates.IsReady}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Menu.StartWithWindows}" Tag="&#xE7E8;" IsCheckable="True" IsChecked="{Binding StartWithWindows}" />
            <Separator />
            <MenuItem Header="{DynamicResource Menu.Exit}" Tag="&#xE711;" Command="{Binding ExitCommand}" />
        </ContextMenu>
        </ResourceDictionary>
    </Application.Resources>
</Application>
